<?xml version="1.0"?>
<ruleset name="MSP Nexus">
  <description>WordPress and PHP compatibility standards for production packages.</description>
  <file>packages/msp-nexus</file>
  <file>packages/msp-nexus-core</file>
  <file>packages/msp-nexus-child</file>
  <exclude-pattern>*/vendor/*</exclude-pattern>
  <arg name="extensions" value="php"/>
  <arg name="parallel" value="8"/>
  <rule ref="WordPress"/>
  <rule ref="WordPress-Extra"/>
  <rule ref="PHPCompatibilityWP">
    <properties><property name="testVersion" value="7.4-"/></properties>
  </rule>
  <config name="minimum_supported_wp_version" value="6.7"/>
  <config name="testVersion" value="7.4-"/>
</ruleset>
