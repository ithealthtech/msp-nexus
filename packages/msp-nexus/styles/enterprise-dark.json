{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "title": "Enterprise Dark",
  "settings": {
    "color": {
      "palette": [
        { "slug": "ink", "name": "Ink", "color": "#050b16" },
        { "slug": "navy", "name": "Navy", "color": "#101d33" },
        { "slug": "slate", "name": "Slate", "color": "#8191a8" },
        { "slug": "mist", "name": "Mist", "color": "#26364d" },
        { "slug": "cloud", "name": "Cloud", "color": "#101d33" },
        { "slug": "white", "name": "White", "color": "#f7fbff" },
        { "slug": "cyan", "name": "Action cyan", "color": "#36e0ee" },
        { "slug": "cyan-dark", "name": "Action cyan dark", "color": "#36e0ee" },
        { "slug": "violet", "name": "Innovation violet", "color": "#9b87ff" },
        { "slug": "success", "name": "Success", "color": "#3ddc97" },
        { "slug": "warning", "name": "Warning", "color": "#f9b44d" }
      ]
    }
  },
  "styles": { "color": { "background": "var:preset|color|ink", "text": "var:preset|color|white" }, "elements": { "link": { "color": { "text": "var:preset|color|cyan" } } } }
}
