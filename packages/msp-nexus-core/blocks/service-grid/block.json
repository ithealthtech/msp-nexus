{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "msp-nexus/service-grid",
  "version": "0.5.3",
  "title": "MSP Service Grid",
  "category": "widgets",
  "icon": "screenoptions",
  "description": "Displays a curated grid of published MSP services.",
  "textdomain": "msp-nexus-core",
  "attributes": {
    "count": { "type": "number", "default": 6 },
    "columns": { "type": "number", "default": 3 },
    "showExcerpt": { "type": "boolean", "default": true }
  },
  "supports": { "align": ["wide", "full"], "anchor": true, "html": false, "spacing": { "margin": true, "padding": true } },
  "render": "file:./render.php",
  "editorScript": "msp-nexus-core-blocks-editor",
  "style": "file:./style.css"
}
