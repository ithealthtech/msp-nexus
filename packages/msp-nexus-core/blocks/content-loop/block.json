{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "msp-nexus/content-loop",
  "version": "0.5.0",
  "title": "Nexus Content Loop",
  "category": "msp-nexus",
  "icon": "update",
  "description": "A visual query loop for public WordPress and MSP content types.",
  "textdomain": "msp-nexus-core",
  "attributes": {
    "postType": { "type": "string", "default": "msp_service" },
    "taxonomy": { "type": "string", "default": "" },
    "terms": { "type": "string", "default": "" },
    "taxonomy2": { "type": "string", "default": "" },
    "terms2": { "type": "string", "default": "" },
    "taxRelation": { "type": "string", "default": "AND" },
    "relatedTaxonomy": { "type": "string", "default": "" },
    "metaKey": { "type": "string", "default": "" },
    "metaValue": { "type": "string", "default": "" },
    "metaCompare": { "type": "string", "default": "=" },
    "includeIds": { "type": "string", "default": "" },
    "excludeIds": { "type": "string", "default": "" },
    "authors": { "type": "string", "default": "" },
    "offset": { "type": "number", "default": 0 },
    "excludeCurrent": { "type": "boolean", "default": true },
    "count": { "type": "number", "default": 6 },
    "columns": { "type": "number", "default": 3 },
    "orderBy": { "type": "string", "default": "menu_order" },
    "order": { "type": "string", "default": "ASC" },
    "showImage": { "type": "boolean", "default": true },
    "showExcerpt": { "type": "boolean", "default": true },
    "showMeta": { "type": "boolean", "default": false },
    "showPagination": { "type": "boolean", "default": false },
    "buttonLabel": { "type": "string", "default": "Learn more" },
    "templateSlug": { "type": "string", "default": "" },
    "layout": { "type": "string", "default": "grid" },
    "noResultsText": { "type": "string", "default": "No published content matches this loop." }
  },
  "supports": { "align": ["wide", "full"], "anchor": true, "html": false, "spacing": { "margin": true, "padding": true } },
  "render": "file:./render.php",
  "editorScript": "msp-nexus-core-blocks-editor",
  "style": "msp-nexus-studio"
}
