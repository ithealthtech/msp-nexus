{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "msp-nexus/content-directory",
  "version": "0.5.0",
  "title": "MSP Content Directory",
  "category": "widgets",
  "icon": "filter",
  "description": "Accessible filterable directory for resources, case studies, outcomes, events, people, or locations.",
  "textdomain": "msp-nexus-core",
  "attributes": {
    "contentType": { "type": "string", "default": "msp_resource" },
    "count": { "type": "number", "default": 12 },
    "columns": { "type": "number", "default": 3 },
    "showFilters": { "type": "boolean", "default": true }
  },
  "supports": { "align": ["wide", "full"], "anchor": true, "html": false },
  "render": "file:./render.php",
  "editorScript": "msp-nexus-core-blocks-editor",
  "style": "file:./style.css"
}
