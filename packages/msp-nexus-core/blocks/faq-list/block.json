{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "msp-nexus/faq-list",
  "version": "0.5.4",
  "title": "MSP FAQ List",
  "category": "widgets",
  "icon": "editor-help",
  "description": "Accessible server-rendered FAQs with a no-script disclosure fallback.",
  "textdomain": "msp-nexus-core",
  "attributes": { "count": { "type": "number", "default": 8 }, "openFirst": { "type": "boolean", "default": false } },
  "supports": { "align": ["wide"], "anchor": true, "html": false },
  "render": "file:./render.php",
  "editorScript": "msp-nexus-core-blocks-editor",
  "style": "file:./style.css"
}
